# Cluster settings for hpc/setup_run.py (KEY=VALUE).  Copy to e.g. ozstar.env / nt.env and fill in:
# nothing below is filled in for you, because module names, accounts and paths are specific to each machine.

ACCOUNT=                      # SLURM account / project (leave empty to omit the line)
PARTITION=                    # partition / queue (leave empty to omit)

MODULES=                      # space-separated, e.g.  gcc openmpi hdf5 gsl fftw  (exact names: `module avail`)
ENV_SETUP=                    # a line run before the jobs: activate the Python environment with galaxy-components,
                              #   e.g.  source $HOME/venvs/gc/bin/activate
LAUNCHER=srun                 # srun or mpirun
AREPO_BIN=                    # full path to the Arepo executable built with your Config.sh

IC_CPUS=8                     # IC generation is one task, threaded numpy/scipy
IC_MEM=64G
IC_TIME=04:00:00

AREPO_NODES=2
AREPO_NTASKS_PER_NODE=32
AREPO_MEM_PER_CPU=            # e.g. 3G (empty to omit)
AREPO_TIME=24:00:00
